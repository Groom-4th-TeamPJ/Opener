# 환경 변수 파일 (절대 커밋 금지!)
.env
.env.local
.env.*.local

# 각 서비스별 환경 파일
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# Docker volumes
postgres_data/
redis_data/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# util
.claude
.idea

# tokensave 코드 인덱스 DB (로컬 전용, 10MB+)
.tokensave/

# Node / pnpm
frontend/.pnpm-store/
frontend/node_modules/
dist/
# Backend 빌드 결과
backend/build/
docs/

*.md

# ── 정산 산출물 추적 예외 ─────────────────────────────────────────
# 위 docs/ 전체 무시는 유지하되 backend/docs 안의 "텍스트 산출물"만 연다.
# 근거: 포트폴리오의 모든 수치가 산출물 파일로 역추적 가능해야 한다는 검증 규칙.
# 이미지·PDF 는 계속 무시한다 (13MB 이상이라 저장소에 넣지 않는다).
!backend/docs/
backend/docs/*
!backend/docs/portfolio/
backend/docs/portfolio/*
!backend/docs/portfolio/*.html
!backend/docs/measurements/
backend/docs/measurements/*
!backend/docs/measurements/*.md
!backend/docs/measurements/*.html
