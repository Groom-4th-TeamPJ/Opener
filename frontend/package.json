    "@tanstack/react-query": "^5.90.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jwt-decode": "^4.0.0",
    "katex": "^0.16.27",
    "lucide-react": "^0.562.0",
    "marked": "^17.0.1",
    "next": "16.1.0",
    "next-themes": "^0.4.6",
    "orval": "^7.17.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
