#!/bin/sh
set -e

# Check if any frontend files are staged
FRONTEND_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep "^frontend/" || true)

if [ -n "$FRONTEND_FILES" ]; then
  echo "📦 Frontend files detected, running checks..."

  cd frontend

  # Type checking (incremental mode)
  echo "🔍 Running type check..."
  pnpm type-check

  # Lint staged files
  echo "🛠️ Running lint-staged..."
  pnpm lint-staged

  echo "✅ All frontend checks passed!"
fi
