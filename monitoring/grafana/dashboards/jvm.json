{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "liveNow": false,
  "panels": [
    {
      "type": "timeseries",
      "title": "Heap Used vs Max",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sum(jvm_memory_used_bytes{area=\"heap\",job=\"app-backend\"})", "legendFormat": "Used", "refId": "A"},
        {"expr": "sum(jvm_memory_max_bytes{area=\"heap\",job=\"app-backend\"})", "legendFormat": "Max", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "GC Pause (p95)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, action) (rate(jvm_gc_pause_seconds_bucket{job=\"app-backend\"}[5m])))", "legendFormat": "{{action}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Threads",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "jvm_threads_live_threads{job=\"app-backend\"}", "legendFormat": "live", "refId": "A"},
        {"expr": "jvm_threads_daemon_threads{job=\"app-backend\"}", "legendFormat": "daemon", "refId": "B"},
        {"expr": "jvm_threads_peak_threads{job=\"app-backend\"}", "legendFormat": "peak", "refId": "C"}
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU Usage (process)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "process_cpu_usage{job=\"app-backend\"}", "legendFormat": "process", "refId": "A"},
        {"expr": "system_cpu_usage{job=\"app-backend\"}", "legendFormat": "system", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["opener", "jvm"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {"selected": true, "text": "Prometheus", "value": "Prometheus"}
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "Opener — JVM / Spring Boot",
  "uid": "opener-jvm",
  "version": 1
}
