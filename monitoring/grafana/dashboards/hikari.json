{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Connection Pool",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "hikaricp_connections_active{job=\"app-backend\"}", "legendFormat": "active", "refId": "A"},
        {"expr": "hikaricp_connections_idle{job=\"app-backend\"}", "legendFormat": "idle", "refId": "B"},
        {"expr": "hikaricp_connections_pending{job=\"app-backend\"}", "legendFormat": "pending", "refId": "C"},
        {"expr": "hikaricp_connections_max{job=\"app-backend\"}", "legendFormat": "max", "refId": "D"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Acquire Time (p95)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(hikaricp_connections_acquire_seconds_bucket{job=\"app-backend\"}[5m])))", "legendFormat": "acquire p95", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(hikaricp_connections_usage_seconds_bucket{job=\"app-backend\"}[5m])))", "legendFormat": "usage p95", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "Pool Saturation %",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "(hikaricp_connections_active{job=\"app-backend\"} / clamp_min(hikaricp_connections_max{job=\"app-backend\"}, 1))", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"value": null, "color": "green"},
            {"value": 0.7, "color": "yellow"},
            {"value": 0.9, "color": "red"}
          ]}
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Timeout / Creation Count",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "increase(hikaricp_connections_timeout_total{job=\"app-backend\"}[5m])", "legendFormat": "timeout/5m", "refId": "A"},
        {"expr": "increase(hikaricp_connections_creation_seconds_count{job=\"app-backend\"}[5m])", "legendFormat": "created/5m", "refId": "B"}
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["opener", "hikari", "db"],
  "templating": {
    "list": [
      {"name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus", "current": {"selected": true, "text": "Prometheus", "value": "Prometheus"}}
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "Opener — HikariCP / JPA",
  "uid": "opener-hikari",
  "version": 1
}
