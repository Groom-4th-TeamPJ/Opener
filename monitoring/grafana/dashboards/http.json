{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests per second",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sum by (method) (rate(http_server_requests_seconds_count{job=\"app-backend\"}[1m]))", "legendFormat": "{{method}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Error Rate (5xx)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sum(rate(http_server_requests_seconds_count{job=\"app-backend\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"app-backend\"}[5m])), 0.001)", "legendFormat": "5xx ratio", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "max": 1, "min": 0}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Latency p95 / p99",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"app-backend\"}[5m])))", "legendFormat": "p95 {{uri}}", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"app-backend\"}[5m])))", "legendFormat": "p99 {{uri}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "type": "logs",
      "title": "Error Logs (Loki)",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 16},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [
        {"expr": "{service=\"backend\",level=~\"ERROR|WARN\"}", "refId": "A"}
      ],
      "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["opener", "http"],
  "templating": {
    "list": [
      {"name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus", "current": {"selected": true, "text": "Prometheus", "value": "Prometheus"}},
      {"name": "DS_LOKI", "type": "datasource", "query": "loki", "current": {"selected": true, "text": "Loki", "value": "Loki"}}
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "Opener — HTTP API",
  "uid": "opener-http",
  "version": 1
}
